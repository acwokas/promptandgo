---
const cur = Astro.url.pathname;
const navLinks = [
  { href: "/languages", label: "Languages" },
  { href: "/optimize", label: "Optimiser" },
  { href: "/library", label: "Browse" },
  { href: "/packs", label: "Power Packs" },
  { href: "/pricing", label: "Pricing" },
  { href: "/tips", label: "Guides" },
];
function isActive(href: string): boolean {
  if (href === "/") return cur === "/";
  return cur === href || cur.startsWith(href + "/");
}
---
<header class="sticky top-0 z-40 w-full border-b border-border bg-background">
  <div class="container max-w-7xl flex h-16 md:h-18 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="PromptAndGo home">
      <img src="/brand/logo.png" alt="PromptAndGo.ai" width="240" height="36" class="h-8 md:h-10 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-8 text-[15px] font-medium" aria-label="Main">
      {navLinks.map(l => (
        <a href={l.href}
           class={`relative py-2 transition-colors ${isActive(l.href) ? "text-foreground" : "text-foreground/70 hover:text-foreground"}`}>
          {l.label}
          {isActive(l.href) && <span class="absolute -bottom-[19px] left-0 right-0 h-0.5 bg-primary"></span>}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Desktop auth cluster. The wrapper is permanently hidden below md, so the
           JS state toggle below can never leak these onto the mobile header. -->
      <div class="hidden md:flex items-center gap-2">
        <div id="auth-buttons-desktop" class="flex items-center gap-2">
          <a href="/auth" class="inline-flex items-center justify-center rounded-lg px-3.5 h-10 text-[15px] font-medium text-foreground/80 hover:text-foreground hover:bg-secondary transition-colors">
            Sign in
          </a>
          <a href="/auth?action=signup"
             class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-5 h-10 text-[15px] font-semibold hover:bg-primary/90 transition-colors">
            Start free
          </a>
        </div>
        <div id="auth-user-desktop" class="hidden items-center gap-2"></div>
      </div>

      <!-- Mobile: hamburger only -->
      <button id="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer"
              class="md:hidden inline-flex items-center justify-center rounded-lg w-11 h-11 hover:bg-secondary text-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer: overlay + right slide-in panel. Holds all nav + auth. -->
  <div id="mobile-overlay" class="md:hidden fixed inset-0 z-50 bg-foreground/40 opacity-0 pointer-events-none transition-opacity duration-200"></div>
  <aside id="mobile-drawer" aria-label="Site menu" aria-hidden="true"
         class="md:hidden fixed top-0 right-0 z-50 h-[100dvh] w-[min(20rem,86vw)] bg-background border-l border-border shadow-xl flex flex-col translate-x-full transition-transform duration-200 ease-out">
    <div class="flex items-center justify-between h-16 px-5 border-b border-border shrink-0">
      <span class="text-sm font-semibold uppercase tracking-wider text-foreground/55">Menu</span>
      <button id="mobile-close" type="button" aria-label="Close menu"
              class="inline-flex items-center justify-center rounded-lg w-11 h-11 hover:bg-secondary text-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 py-3 flex flex-col gap-0.5" aria-label="Mobile">
      {navLinks.map(l => (
        <a href={l.href}
           class={`flex items-center min-h-[44px] px-3 rounded-lg text-base ${isActive(l.href) ? "text-primary font-semibold bg-secondary/60" : "text-foreground/85 hover:bg-secondary/50"}`}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="px-5 py-5 border-t border-border shrink-0">
      <div id="auth-buttons-mobile" class="flex flex-col gap-3">
        <a href="/auth" class="inline-flex items-center justify-center min-h-[44px] text-base font-medium text-foreground/80 hover:text-foreground">Sign in</a>
        <a href="/auth?action=signup" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground min-h-[48px] text-base font-semibold hover:bg-primary/90 transition-colors">Start free</a>
      </div>
      <div id="auth-user-mobile" class="hidden flex-col gap-1"></div>
    </div>
  </aside>
</header>

<script is:inline>
  (function(){
    var toggle = document.getElementById('mobile-toggle');
    var closeBtn = document.getElementById('mobile-close');
    var drawer = document.getElementById('mobile-drawer');
    var overlay = document.getElementById('mobile-overlay');
    if (!toggle || !drawer || !overlay) return;
    var open = false;

    function show(){
      drawer.classList.remove('translate-x-full');
      overlay.classList.remove('opacity-0','pointer-events-none');
      drawer.setAttribute('aria-hidden','false');
      toggle.setAttribute('aria-expanded','true');
      document.body.style.overflow = 'hidden';
      open = true;
    }
    function hide(){
      drawer.classList.add('translate-x-full');
      overlay.classList.add('opacity-0','pointer-events-none');
      drawer.setAttribute('aria-hidden','true');
      toggle.setAttribute('aria-expanded','false');
      document.body.style.overflow = '';
      open = false;
    }
    function openDrawer(){
      if (open) return;
      show();
      // Push a history entry so the device back gesture closes the drawer.
      try { history.pushState({ pagDrawer: true }, ''); } catch(e){}
    }
    function dismiss(){
      if (!open) return;
      if (history.state && history.state.pagDrawer) { history.back(); }
      else { hide(); }
    }
    toggle.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', dismiss);
    overlay.addEventListener('click', dismiss);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') dismiss(); });
    window.addEventListener('popstate', function(){ if (open) hide(); });
    // Tapping any link inside the drawer closes it; navigation then follows.
    drawer.addEventListener('click', function(e){
      var t = e.target;
      while (t && t !== drawer) {
        if (t.tagName === 'A') { hide(); break; }
        t = t.parentNode;
      }
    });
  })();
</script>

<script>
  import { sb } from "../lib/auth-client";

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c]);
  }

  // Only allow http(s) URLs into an <img src> attribute — blocks javascript:/data: URIs
  // and (combined with escapeHtml below) neutralizes attribute-breakout via a crafted
  // avatar_url value like `x" onerror="...`.
  function safeAvatarUrl(url) {
    try {
      const u = new URL(url, window.location.origin);
      if (u.protocol !== "http:" && u.protocol !== "https:") return "";
      return u.href;
    } catch {
      return "";
    }
  }

  function paint(user) {
    const desktopBtns = document.getElementById("auth-buttons-desktop");
    const desktopUser = document.getElementById("auth-user-desktop");
    const mobileBtns = document.getElementById("auth-buttons-mobile");
    const mobileUser = document.getElementById("auth-user-mobile");
    if (!desktopBtns || !desktopUser) return;

    if (user) {
      const email = escapeHtml(user.email || "Account");
      const avatar = safeAvatarUrl(user.user_metadata?.avatar_url || "");
      const rawName = user.user_metadata?.full_name || user.user_metadata?.name || (user.email || "Account").split("@")[0];
      const fullName = escapeHtml(rawName);
      const initials = escapeHtml((rawName || email).slice(0, 2).toUpperCase());
      const avatarMarkup = avatar
        ? `<img src="${escapeHtml(avatar)}" alt="" class="w-8 h-8 rounded-full object-cover" referrerpolicy="no-referrer" />`
        : `<span class="w-8 h-8 rounded-full bg-primary text-primary-foreground inline-flex items-center justify-center text-xs font-bold">${initials}</span>`;

      // Desktop: swap buttons -> account menu. The md gate lives on the wrapper,
      // so we only toggle flex/hidden here (never the responsive prefix).
      desktopBtns.classList.add("hidden");
      desktopBtns.classList.remove("flex");
      desktopUser.classList.remove("hidden");
      desktopUser.classList.add("flex");
      desktopUser.innerHTML = `
        <div class="relative">
          <button id="account-trigger" type="button" aria-haspopup="menu" aria-expanded="false"
                  class="inline-flex items-center gap-2 rounded-full pl-1 pr-3 h-10 hover:bg-secondary transition-colors text-[14px] font-semibold">
            ${avatarMarkup}
            <span class="hidden md:inline max-w-[140px] truncate">${fullName}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="account-menu" role="menu"
               class="hidden absolute right-0 top-full mt-2 w-64 rounded-xl border border-border bg-background shadow-lg overflow-hidden z-50">
            <div class="px-4 py-3 border-b border-border bg-secondary/30">
              <div class="text-sm font-semibold text-foreground truncate">${fullName}</div>
              <div class="text-xs text-muted-foreground truncate">${email}</div>
            </div>
            <a href="/account/profile" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-secondary transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              My account
            </a>
            <a href="/account/saved" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-secondary transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
              Saved prompts
            </a>
            <a href="/account/purchases" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-secondary transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              Purchases
            </a>
            <button id="account-signout" role="menuitem" type="button"
                    class="w-full flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-secondary transition-colors border-t border-border text-foreground/80">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign out
            </button>
          </div>
        </div>
      `;

      const trigger = document.getElementById("account-trigger");
      const menu = document.getElementById("account-menu");
      const closeMenu = () => { menu?.classList.add("hidden"); trigger?.setAttribute("aria-expanded","false"); };
      const openMenu = () => { menu?.classList.remove("hidden"); trigger?.setAttribute("aria-expanded","true"); };
      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (menu?.classList.contains("hidden")) openMenu(); else closeMenu();
      });
      document.addEventListener("click", (e) => {
        if (!menu || !trigger) return;
        if (menu.classList.contains("hidden")) return;
        if (!menu.contains(e.target) && !trigger.contains(e.target)) closeMenu();
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMenu(); });
      document.getElementById("account-signout")?.addEventListener("click", signOut);

      if (mobileBtns && mobileUser) {
        // Mobile drawer: swap the Sign in / Start free block for account links.
        mobileBtns.classList.add("hidden");
        mobileBtns.classList.remove("flex");
        mobileUser.classList.remove("hidden");
        mobileUser.classList.add("flex");
        mobileUser.innerHTML = `
          <div class="px-1 pb-2 text-sm font-semibold text-foreground truncate">${fullName}</div>
          <a href="/account/profile" class="flex items-center min-h-[44px] px-1 text-base text-foreground/85">My account</a>
          <a href="/account/saved" class="flex items-center min-h-[44px] px-1 text-base text-foreground/85">Saved prompts</a>
          <a href="/account/purchases" class="flex items-center min-h-[44px] px-1 text-base text-foreground/85">Purchases</a>
          <button id="signout-mobile" type="button" class="mt-2 inline-flex items-center justify-center rounded-lg bg-secondary text-foreground min-h-[48px] text-base font-semibold">Sign out</button>
        `;
        document.getElementById("signout-mobile")?.addEventListener("click", signOut);
      }
    } else {
      desktopBtns.classList.remove("hidden");
      desktopBtns.classList.add("flex");
      desktopUser.classList.add("hidden");
      desktopUser.classList.remove("flex");
      desktopUser.innerHTML = "";
      if (mobileBtns && mobileUser) {
        mobileBtns.classList.remove("hidden");
        mobileBtns.classList.add("flex");
        mobileUser.classList.add("hidden");
        mobileUser.classList.remove("flex");
        mobileUser.innerHTML = "";
      }
    }
  }

  async function signOut() {
    try { await sb().auth.signOut(); } catch (e) {}
    window.location.href = "/";
  }

  async function init() {
    const c = sb();
    const { data: { user } } = await c.auth.getUser();
    paint(user);
    c.auth.onAuthStateChange((_evt, session) => paint(session?.user || null));
  }
  init();
</script>
