---
import { LANGUAGES } from "@astro/lib/languages";
import ModelBadges from "@astro/components/ModelBadges.astro";

interface Props {
  /** Optional override for the prompt count shown in the eyebrow */
  total?: number;
  /** "home" trims supporting copy; "page" is the fuller /languages header */
  variant?: "home" | "page";
}
const { variant = "home" } = Astro.props;
---
<section class="container max-w-5xl pt-16 md:pt-24 pb-10 md:pb-14 text-center">
  <span class="inline-flex items-center gap-2 rounded-full border border-border bg-secondary/60 px-3.5 py-1.5 text-xs font-medium text-foreground/80 mb-7">
    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
    Native scripts · Local AI models · Cultural register
  </span>

  <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] text-foreground">
    Prompts built for how Asia
    <span class="text-gradient-brand">actually uses AI.</span>
  </h1>

  <p class="mt-6 text-lg md:text-xl text-foreground/80 max-w-2xl mx-auto leading-relaxed">
    {variant === "home"
      ? "In your language, on the models you actually use, in the register your customers expect. Western frontier models and the local Asian models your market runs on."
      : "Each language has its own prompts, tested on the local AI models that market runs on, in the register and script your customers expect. Choose one to start."}
  </p>

  <!-- FOCAL POINT — each market shows its native script + the local models we test on -->
  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 text-left">
    {LANGUAGES.map(l => (
      <a
        href={`/${l.tag}`}
        class="group flex flex-col rounded-2xl border border-border bg-card p-5 card-lift"
        aria-label={`Prompts and local AI models for ${l.english}`}
      >
        <div class="flex items-baseline gap-2.5">
          <span lang={l.tag} class="text-2xl md:text-3xl font-extrabold tracking-tight text-foreground group-hover:text-primary transition-colors">{l.native}</span>
          <span class="text-sm font-medium text-foreground/55">{l.english}</span>
        </div>
        <div class="mt-3.5">
          <div class="text-[10px] font-semibold uppercase tracking-wider text-foreground/45 mb-1.5">Tested on</div>
          <ModelBadges models={l.models} variant="compact" localOnly />
        </div>
      </a>
    ))}
  </div>

  <div class="mt-9 flex flex-col sm:flex-row gap-3 justify-center">
    {variant === "home" ? (
      <a href="/languages"
         class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground px-7 h-12 text-base font-semibold hover:bg-primary/90 transition-colors">
        Browse by language →
      </a>
    ) : (
      <a href="/library"
         class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground px-7 h-12 text-base font-semibold hover:bg-primary/90 transition-colors">
        Browse every prompt →
      </a>
    )}
    <a href="/optimize"
       class="inline-flex items-center justify-center rounded-xl border-2 border-border bg-background hover:bg-secondary px-7 h-12 text-base font-semibold transition-colors">
      Try the optimiser for free
    </a>
  </div>
  <p class="mt-4 text-sm text-foreground/60">
    No signup required. <a href="/models" class="text-primary font-medium hover:underline">See the full model coverage</a>.
  </p>
</section>
