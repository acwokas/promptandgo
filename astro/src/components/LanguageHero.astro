---
import { LANGUAGES } from "@astro/lib/languages";

interface Props {
  /** Optional override for the prompt count shown in the eyebrow */
  total?: number;
  /** "home" trims supporting copy; "page" is the fuller /languages header */
  variant?: "home" | "page";
}
const { total, variant = "home" } = Astro.props;
const countLabel = total && total > 0 ? total.toLocaleString() : "1,000+";
---
<section class="container max-w-5xl pt-16 md:pt-24 pb-10 md:pb-14 text-center">
  <span class="inline-flex items-center gap-2 rounded-full border border-border bg-secondary/60 px-3.5 py-1.5 text-xs font-medium text-foreground/80 mb-7">
    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
    {countLabel} prompts · 12+ Asian languages · written in the local register
  </span>

  <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] text-foreground">
    AI prompts in
    <span class="text-gradient-brand">your language.</span>
  </h1>

  <p class="mt-6 text-lg md:text-xl text-foreground/80 max-w-2xl mx-auto leading-relaxed">
    {variant === "home"
      ? "Not translated English. Prompts written natively in the languages of Asia, with the right register, script and idiom for each market. Pick a language to start."
      : "Every language below has its own prompts, calibrated to the register, script and idiom of that market. Choose one to browse prompts written for it."}
  </p>

  <!-- LANGUAGE FOCAL POINT — native scripts, scannable, each links to its landing -->
  <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
    {LANGUAGES.map(l => (
      <a
        href={`/${l.tag}`}
        class="group flex flex-col items-center justify-center rounded-2xl border border-border bg-card p-5 md:p-6 card-lift"
        aria-label={`Prompts in ${l.english}`}
      >
        <div lang={l.tag} class="text-2xl md:text-3xl font-extrabold tracking-tight text-foreground group-hover:text-primary transition-colors">
          {l.native}
        </div>
        <div class="mt-1.5 text-xs md:text-sm font-medium text-foreground/60">{l.english}</div>
      </a>
    ))}
  </div>

  <div class="mt-9 flex flex-col sm:flex-row gap-3 justify-center">
    {variant === "home" ? (
      <a href="/languages"
         class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground px-7 h-12 text-base font-semibold hover:bg-primary/90 transition-colors">
        Browse by language →
      </a>
    ) : (
      <a href="/library"
         class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground px-7 h-12 text-base font-semibold hover:bg-primary/90 transition-colors">
        Browse every prompt →
      </a>
    )}
    <a href="/optimize"
       class="inline-flex items-center justify-center rounded-xl border-2 border-border bg-background hover:bg-secondary px-7 h-12 text-base font-semibold transition-colors">
      Try the optimiser for free
    </a>
  </div>
  <p class="mt-3 text-sm text-foreground/60">No signup required. Works with any AI account you already have.</p>
</section>
