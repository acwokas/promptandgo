---
import Layout from "@astro/layouts/Layout.astro";
import { loadApprovedGlossary } from "../../scripts/glossary-approval.mjs";
const glossary = loadApprovedGlossary();
type GlossaryTerm = { term: string; def: string; source: string };
const terms: GlossaryTerm[] = glossary.terms;
const groups = terms.reduce((acc: Record<string, typeof terms>, t) => {
  const k = t.term[0].toUpperCase();
  acc[k] = acc[k] || [];
  acc[k].push(t);
  return acc;
}, {});
const letters = Object.keys(groups).sort();
---
<Layout title={glossary.title} description={glossary.description}>
  <section class="relative overflow-hidden">
    <div class="brand-orb w-[400px] h-[400px] -top-20 -left-20" style="background: hsl(var(--brand-purple));"></div>
    <div class="relative container max-w-4xl pt-16 md:pt-20 pb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Glossary</span>
      <h1 class="mt-3 text-4xl md:text-6xl font-extrabold tracking-tight">{glossary.heading}</h1>
      <p class="mt-5 text-lg text-foreground/70 max-w-xl">{glossary.introduction}</p>
    </div>
  </section>

  <section class="container max-w-4xl pb-16">
    <!-- Letter index -->
    <nav class="flex flex-wrap gap-2 mb-10" aria-label="Glossary index">
      {letters.map(L => (
        <a href={`#letter-${L}`} class="w-9 h-9 rounded-lg border border-border/60 bg-card grid place-items-center font-semibold text-sm hover:border-primary/40 hover:text-primary transition-colors">{L}</a>
      ))}
    </nav>

    {letters.map(L => (
      <div id={`letter-${L}`} class="mb-10 scroll-mt-24">
        <h2 class="text-2xl font-extrabold text-gradient-brand mb-4">{L}</h2>
        <dl class="divide-y divide-border/60 rounded-2xl border border-border/60 bg-card">
          {groups[L].map(t => (
            <div class="p-5 md:p-6">
              <dt class="font-semibold text-base md:text-lg">{t.term}</dt>
              <dd class="mt-1.5 text-sm md:text-base text-foreground/70 leading-relaxed">{t.def}{t.source && (<a href={t.source} class="ml-2 underline underline-offset-2" target="_blank" rel="noopener noreferrer" aria-label={`Source for ${t.term}`}>Source</a>)}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </section>
</Layout>
