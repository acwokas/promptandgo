---
import Layout from "@astro/layouts/Layout.astro";
import { ALL_TERMS, TERMS_BY_SLUG } from "@astro/lib/glossary";

export async function getStaticPaths() {
  return ALL_TERMS.map((t) => ({ params: { slug: t.slug }, props: t }));
}

const term = Astro.props as any;
const related = (term.related || [])
  .map((slug: string) => TERMS_BY_SLUG[slug])
  .filter(Boolean);

const ld = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term.term,
  alternateName: term.aliases,
  description: term.shortDefinition,
  url: `https://www.promptandgo.ai/glossary/${term.slug}`,
  inDefinedTermSet: "https://www.promptandgo.ai/glossary",
  ...(term.sources?.length ? { subjectOf: term.sources.map((s: any) => ({ "@type": "CreativeWork", name: s.label, url: s.url })) } : {}),
};
---
<Layout
  title={`${term.term}: Definition — PromptAndGo Glossary`}
  description={term.shortDefinition}
  canonical={`https://www.promptandgo.ai/glossary/${term.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>

  <section class="container max-w-3xl pt-12 md:pt-16 pb-6">
    <a href="/glossary" class="text-sm text-muted-foreground hover:text-primary inline-flex items-center gap-1.5">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Glossary
    </a>
    <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
      <span class="font-semibold uppercase tracking-wider">{term.category}</span>
      {term.aliases?.length > 0 && <><span>&middot;</span><span>Also: {term.aliases.join(", ")}</span></>}
    </div>
    <h1 class="mt-3 text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">{term.term}</h1>
    <p class="mt-4 text-lg text-foreground/70 leading-relaxed">{term.shortDefinition}</p>
  </section>

  <article class="container max-w-3xl pb-12">
    <div class="prose prose-lg dark:prose-invert max-w-none mt-8">
      {term.body.map((p: string) => <p>{p}</p>)}
    </div>

    {term.sources?.length > 0 && (
      <div class="mt-10 pt-6 border-t border-border/40">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Sources</h2>
        <ul class="space-y-1.5 text-sm">
          {term.sources.map((s: any) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {term.seeAlso?.length > 0 && (
      <div class="mt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">See also</h2>
        <ul class="space-y-1.5 text-sm">
          {term.seeAlso.map((s: any) => (
            <li><a href={s.href} class="text-primary hover:underline">{s.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-12 pt-8 border-t border-border/40 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
      <a href="/glossary" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        More terms
      </a>
      <a href="/optimize" class="inline-flex items-center justify-center rounded-xl bg-gradient-brand text-white px-5 h-11 font-semibold shadow-brand hover:shadow-brand-lg transition-all">
        Try the optimiser &rarr;
      </a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="container max-w-6xl pb-20">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight mb-5">Related terms</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {related.map((r: any) => (
          <a href={`/glossary/${r.slug}`} class="group card-lift rounded-2xl border border-border/60 bg-card p-5 flex flex-col">
            <h3 class="text-base font-bold tracking-tight">{r.term}</h3>
            <p class="mt-2 text-sm text-foreground/70 leading-relaxed flex-1 line-clamp-3">{r.shortDefinition}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <style>
    .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  </style>
</Layout>
