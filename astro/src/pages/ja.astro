---
import Layout from "@astro/layouts/Layout.astro";
import LandingHero from "@astro/components/LandingHero.astro";
---
<Layout
  title="日本語向けAIプロンプト | PromptAndGo"
  description="敬語、ビジネスマナー、業界文脈に対応した日本語AIプロンプト。Karakuri、ELYZA、Claude、ChatGPT向けに最適化。"
>
  <LandingHero
    langTag="ja"
    langLabel="日本語"
    langSub="Japanese"
    hero={{
      title: "あなたの日本語で、あなたが使うAIに。",
      subtitle: "BtoBメール、社内告知、提案書、カスタマーサポート。「いきなりカジュアル」にならない、すぐ使える日本語プロンプト。国内モデルにも対応。",
      cta: "無料で最適化を試す"
    }}
    features={[
      { title: "敬語の精度", desc: "尊敬語・謙譲語・丁寧語を文脈に応じて自動調整。社外、社内、カスタマー対応で出力スタイルが変わります。" },
      { title: "業界別テンプレート", desc: "金融、SaaS、製造、小売、教育。用語と慣習に合わせたプロンプト集。" },
      { title: "国内モデルにも対応", desc: "Karakuri、Stockmark、ELYZA、Rakuten AI、そしてClaude・ChatGPT・Geminiに最適化。" }
    ]}
    examples={[
      { input: "新規取引先への初回ご挨拶メールを丁寧に作成してください。先方は製造業の役員クラス。", output: "拝啓 時下ますますご清祥のこととお慶び申し上げます。突然のご連絡、誠に恐縮でございます…" },
      { input: "社内告知:来週の全社ミーティングについて、簡潔かつ温かみのある文章で。", output: "皆さまお疲れさまです。来週の全社ミーティングのご案内です…" }
    ]}
    register={{
      title: "How Japanese actually wants to be prompted",
      body: "Japanese runs on keigo, and keigo has tiers. Sonkeigo (尊敬語) raises the other person, kenjougo (謙譲語) lowers yourself, and teineigo (丁寧語) keeps things plainly polite. A message to a senior client, an internal notice, and a casual team update each need a different tier. Get the tier wrong and the output reads as cold, presumptuous, or junior. Our prompts set the right level for the context before you generate a word.",
    }}
    useCases={[
      "A Tokyo HR team writing keigo-respectful onboarding messages on Claude.",
      "A Fukuoka SaaS startup drafting BtoB sales emails in sonkeigo on Karakuri.",
      "A Nagoya manufacturer sending supplier notices in the right business register on ELYZA.",
    ]}
    i18n={{
      browseCta: "プロンプトを見る →",
      examplesEyebrow: "事例",
      examplesHeading: "本物のプロンプト、本物の出力。",
      promptLabel: "プロンプト",
      outputLabel: "最適化された出力",
      tryItNow: "今すぐ試す",
      browseAll: "すべてのプロンプトを見る",
      modelsLabel: "対応モデル",
      getInspired: "参考にする",
    }}
  />
</Layout>
