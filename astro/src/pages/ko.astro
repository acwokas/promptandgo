---
import Layout from "@astro/layouts/Layout.astro";
import LandingHero from "@astro/components/LandingHero.astro";
---
<Layout
  title="한국어 AI 프롬프트 | PromptAndGo"
  description="존댓말, 비즈니스 매너, 한국 시장 맥락을 반영한 한국어 AI 프롬프트. HyperCLOVA X, Solar, EXAONE, Claude 최적화."
>
  <LandingHero
    langTag="ko"
    langLabel="한국어"
    langSub="Korean"
    hero={{
      title: "당신의 한국어로, 당신이 쓰는 AI에.",
      subtitle: "B2B 이메일, 사내 공지, 제안서, 고객 지원. 격식과 친근함의 균형을 잘 맞춘 한국어 프롬프트. 국내 모델도 지원합니다.",
      cta: "무료로 최적화 시작하기"
    }}
    features={[
      { title: "정확한 존댓말", desc: "상대와 상황에 맞춰 격식체, 경어, 반말을 자동 조정." },
      { title: "산업별 템플릿", desc: "금융, IT/SaaS, 제조, 유통, 교육. 한국 시장 맥락에 맞춘 프롬프트." },
      { title: "국내 모델 지원", desc: "HyperCLOVA X, Solar, EXAONE, 그리고 Claude, ChatGPT에 최적화된 출력." }
    ]}
    examples={[
      { input: "신규 거래처 임원에게 첫 인사 이메일을 정중하게 작성해 주세요.", output: "안녕하십니까. 갑작스러운 연락 드려 송구합니다…" },
      { input: "사내 공지: 다음 주 전사 회의 안내를 간결하고 따뜻하게.", output: "안녕하세요, 팀원 여러분. 다음 주 전사 회의를 안내드립니다…" }
    ]}
    register={{
      title: "How Korean actually wants to be prompted",
      body: "Korean encodes hierarchy in the grammar itself. Jondaetmal (존댓말) is the polite, formal speech you use with clients, seniors, and customers; banmal (반말) is the casual speech for peers and juniors. Business Korean also tracks rank and seniority closely. Choose the wrong level and a customer notice can sound either stiff or disrespectful. Our prompts match the speech level to who you are writing to.",
    }}
    useCases={[
      "A Seoul fintech writing jondaetmal customer notices on HyperCLOVA X.",
      "A Busan retailer drafting KakaoTalk campaign copy on Solar.",
      "An enterprise team writing internal memos in the right speech level on EXAONE.",
    ]}
    i18n={{
      browseCta: "프롬프트 둘러보기 →",
      examplesEyebrow: "예시",
      examplesHeading: "실제 프롬프트와 실제 결과",
      promptLabel: "프롬프트",
      outputLabel: "최적화된 결과",
      tryItNow: "지금 사용해 보기",
      browseAll: "모든 프롬프트 보기",
      modelsLabel: "지원 모델",
      getInspired: "영감 얻기",
    }}
  />
</Layout>
