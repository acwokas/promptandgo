---
import Layout from "@astro/layouts/Layout.astro";
import LanguageHero from "@astro/components/LanguageHero.astro";
import { LANGUAGES } from "@astro/lib/languages";
import { sbFetch } from "@astro/lib/supabase-rest";

const total = await (async () => {
  try {
    const counts: any[] = await sbFetch(`/rest/v1/prompts?select=category_id&review_status=eq.approved`);
    return counts.length;
  } catch (e) { return 0; }
})();
---
<Layout
  title="Browse Prompts by Language | PromptAndGo"
  description="AI prompts written natively in Japanese, Korean, Chinese, Thai, Vietnamese, Bahasa Indonesia and Malaysia. The right register, script and idiom for each market."
>
  <LanguageHero total={total} variant="page" />

  <!-- PER-LANGUAGE BROWSE — the local-language angle for each market -->
  <section class="container max-w-6xl py-12 md:py-16">
    <div class="max-w-2xl mb-10">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Pick a language</h2>
      <p class="mt-3 text-lg text-foreground/75">Each one is its own landing, with prompts and tone calibrated to that market.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {LANGUAGES.map(l => (
        <a href={`/${l.tag}`} class="group flex flex-col rounded-2xl border border-border bg-card p-6 card-lift" aria-label={`Prompts in ${l.english}`}>
          <div class="flex items-baseline gap-3">
            <span lang={l.tag} class="text-2xl md:text-3xl font-extrabold tracking-tight text-foreground group-hover:text-primary transition-colors">{l.native}</span>
            <span class="text-sm font-medium text-foreground/55">{l.english}</span>
          </div>
          <p class="mt-3 text-sm md:text-[15px] text-foreground/70 leading-relaxed flex-1">{l.angle}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">
            Open {l.english}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="group-hover:translate-x-0.5 transition-transform"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- WHY LOCAL LANGUAGE -->
  <section class="container max-w-6xl py-12 md:py-16">
    <div class="rounded-3xl border border-border bg-secondary/50 p-8 md:p-12">
      <div class="grid md:grid-cols-[1.2fr_2fr] gap-8 md:gap-12 items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight">Local language is the whole point</h2>
          <p class="mt-4 text-foreground/75 leading-relaxed">Translation gets the words. It misses the register, the honorifics and the idiom that make writing read like a local wrote it. Our prompts start in the language, not in English.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <h3 class="text-base font-bold tracking-tight">Right register, every time</h3>
            <p class="mt-2 text-sm text-foreground/70 leading-relaxed">Japanese keigo, Korean honorifics, Bahasa Bapak/Ibu, Thai politeness particles. Set to match who you are writing to.</p>
          </div>
          <div>
            <h3 class="text-base font-bold tracking-tight">Built for the market</h3>
            <p class="mt-2 text-sm text-foreground/70 leading-relaxed">WeChat campaigns, Shopee listings, WhatsApp broadcasts. Prompts shaped by how each market actually communicates.</p>
          </div>
          <div>
            <h3 class="text-base font-bold tracking-tight">Native script handled</h3>
            <p class="mt-2 text-sm text-foreground/70 leading-relaxed">Simplified and Traditional Chinese, Thai, Korean, Japanese. The script is correct before you copy a thing.</p>
          </div>
          <div>
            <h3 class="text-base font-bold tracking-tight">Works on any AI</h3>
            <p class="mt-2 text-sm text-foreground/70 leading-relaxed">ChatGPT, Claude, Gemini, Mistral, Grok and more. Same intent, tuned for whichever model you use.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container max-w-6xl py-12 md:py-16">
    <div class="rounded-3xl border border-border bg-secondary p-10 md:p-14 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Find your language. Ship the work.</h2>
      <p class="mt-4 text-lg text-foreground/75 max-w-2xl mx-auto">Free to browse, free to optimise. Sign up only when you want to save your favourites.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/library" class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground px-7 h-12 font-semibold hover:bg-primary/90 transition-colors">Browse every prompt →</a>
        <a href="/optimize" class="inline-flex items-center justify-center rounded-xl border-2 border-border bg-background hover:bg-card px-7 h-12 font-semibold transition-colors">Optimise a prompt for free</a>
      </div>
    </div>
  </section>
</Layout>
