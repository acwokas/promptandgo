---
import Layout from "@astro/layouts/Layout.astro";
import ModelBadges from "@astro/components/ModelBadges.astro";
import { LANGUAGES } from "@astro/lib/languages";

// Flat list of every local model for the headline count and SEO surface.
const localCount = LANGUAGES.reduce((n, l) => n + l.models.filter((m) => m.local).length, 0);
---
<Layout
  title="AI Model Coverage — Local Asian Models We Test On | PromptAndGo"
  description="Western frontier models are table stakes. We test prompts against the AI models your market actually uses: Qwen, Ernie, DeepSeek, HyperCLOVA X, Sahabat-AI, Typhoon, Karakuri and more."
  canonical="https://www.promptandgo.ai/models"
>
  <section class="container max-w-5xl pt-16 md:pt-24 pb-8 text-center">
    <span class="inline-flex items-center gap-2 rounded-full border border-border bg-secondary/60 px-3.5 py-1.5 text-xs font-medium text-foreground/80 mb-7">
      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
      {localCount} local Asian models · plus the Western frontier
    </span>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05]">
      Model <span class="text-gradient-brand">coverage</span>.
    </h1>
    <p class="mt-6 text-lg md:text-xl text-foreground/80 max-w-2xl mx-auto leading-relaxed">
      Western frontier models are table stakes. We test against the AI models your market actually uses, so a prompt that ships in Jakarta or Seoul reads right on the model your customers are on.
    </p>
  </section>

  <!-- Per-market coverage -->
  <section class="container max-w-5xl py-10 md:py-14">
    <div class="space-y-4">
      {LANGUAGES.map(l => (
        <div class="rounded-2xl border border-border bg-card p-6 md:p-7">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-6">
            <div class="md:w-56 shrink-0">
              <div class="flex items-baseline gap-2.5">
                <span lang={l.tag} class="text-2xl font-extrabold tracking-tight">{l.native}</span>
                <span class="text-sm font-medium text-foreground/55">{l.english}</span>
              </div>
              <div class="mt-1 text-xs text-muted-foreground">Tested for: all {l.english} prompts</div>
            </div>
            <div class="flex-1">
              <ModelBadges models={l.models} variant="grid" />
            </div>
            <div class="shrink-0">
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Live
              </span>
            </div>
          </div>
          {l.modelsNote && (
            <p class="mt-4 text-sm text-muted-foreground leading-relaxed border-t border-border/60 pt-4">{l.modelsNote}</p>
          )}
        </div>
      ))}

      <!-- Frontier row: all markets -->
      <div class="rounded-2xl border border-border bg-secondary/40 p-6 md:p-7">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-6">
          <div class="md:w-56 shrink-0">
            <div class="text-2xl font-extrabold tracking-tight">Frontier</div>
            <div class="mt-1 text-xs text-muted-foreground">Tested for: every language</div>
          </div>
          <div class="flex-1">
            <ModelBadges
              models={[
                { name: "ChatGPT", vendor: "OpenAI", local: false, slug: "chatgpt" },
                { name: "Claude", vendor: "Anthropic", local: false, slug: "claude" },
                { name: "Gemini", vendor: "Google", local: false, slug: "gemini" },
                { name: "Mistral", vendor: "Mistral", local: false, slug: "mistral" },
                { name: "Grok", vendor: "xAI", local: false, slug: "grok" },
              ]}
              variant="grid"
            />
          </div>
          <div class="shrink-0">
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Live
            </span>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-6 text-sm text-muted-foreground text-center max-w-2xl mx-auto">
      Adding a model your market relies on? <a href="/contact" class="text-primary font-medium hover:underline">Tell us</a> and we will test against it.
    </p>
  </section>

  <!-- CTA -->
  <section class="container max-w-5xl pb-16 md:pb-24">
    <div class="rounded-3xl border border-border bg-secondary p-10 md:p-14 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Optimise for your market's model.</h2>
      <p class="mt-4 text-lg text-foreground/75 max-w-2xl mx-auto">Paste a prompt, pick your language and model, and the Optimiser re-renders it for the register and the model your customers actually use.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/optimize" class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground px-7 h-12 font-semibold hover:bg-primary/90 transition-colors">Try the optimiser for free</a>
        <a href="/languages" class="inline-flex items-center justify-center rounded-xl border-2 border-border bg-background hover:bg-card px-7 h-12 font-semibold transition-colors">Browse by language</a>
      </div>
    </div>
  </section>
</Layout>
